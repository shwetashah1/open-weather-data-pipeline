# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Source database: course-provided mmai_db (read-only) ---
# Holds uploads.ca_postal_codes. Same Postgres server as your personal db,
# but a DIFFERENT database, so it needs its own connection.
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=mmai_db
SOURCE_DB_USER=your_username
SOURCE_DB_PASSWORD=your_password

# --- Destination database: your personal database (read/write) ---
# Holds uploads.current_weather, the table this pipeline creates and loads.
DEST_DB_HOST=localhost
DEST_DB_PORT=5432
DEST_DB_NAME=your_personal_db
DEST_DB_USER=your_username
DEST_DB_PASSWORD=your_password

# --- OpenWeather API ---
OPENWEATHER_API_KEY=your_api_key_here

# --- Optional pipeline tuning (defaults shown) ---
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
# REQUEST_TIMEOUT_SECONDS=10
# RATE_LIMIT_CALLS_PER_MINUTE=55
# SQL_FILE_PATH=sql/extract_postal_codes.sql
# CREATE_TABLE_SQL_PATH=sql/create_tables.sql
# LOG_LEVEL=INFO
